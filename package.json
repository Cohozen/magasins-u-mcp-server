{
    "name": "magasins-u-mcp-server",
    "version": "0.1.0",
    "description": "Unofficial MCP server for coursesu.com / magasins-u.com, driven through a real browser session.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "dev": "node --experimental-strip-types src/server.ts",
        "check": "biome check . && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
        "check:fix": "biome check --write .",
        "test": "vitest run"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "patchright": "^1.64.2",
        "pdfjs-dist": "^6.4.299",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.11",
        "@types/node": "^26.4.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
