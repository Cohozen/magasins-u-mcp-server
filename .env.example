# Token required on every request: "Authorization: Bearer <MCP_TOKEN>". 24 characters at least.
# Generate one with: openssl rand -base64 32
MCP_TOKEN=

# Local-network address of the Docker host: used to build the noVNC link given to the agent.
VNC_HOST=192.168.1.10

# Expected store id (the "storeId" cookie on coursesu.com).
# session_status warns when another store is selected.
STORE_ID=

# Browser: chrome (Google Chrome stable, x86_64 only) or chromium (Patchright's).
BROWSER_CHANNEL=chrome

# Random pause between two site requests, in milliseconds.
DELAY_MS=3000-8000
# Daily cap on site requests.
DAILY_REQUEST_CAP=300
# Pause after the site refuses access (HTTP 403/429 without a Cloudflare challenge), in hours.
BLOCK_COOLDOWN_H=24

# Keep-alive visits, in minutes, drawn at random within the range. 30 at most: the site drops
# the session after 30 to 45 minutes without a visit.
KEEPALIVE_DAY_MIN=18-26
KEEPALIVE_NIGHT_MIN=18-26
NIGHT_HOURS=23-07

# Page load timeout, in milliseconds.
PAGE_TIMEOUT_MS=30000

# debug, info, warn or error.
LOG_LEVEL=info
